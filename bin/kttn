#!/bin/sh
set -eu
SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  TARGET=$(readlink "$SCRIPT")
  case "$TARGET" in
    /*) SCRIPT=$TARGET ;;
    *) SCRIPT=$DIR/$TARGET ;;
  esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
NATIVE="$DIR/native/kttn"
# npm may skip the postinstall that downloads the binary (newer npm asks
# before running install scripts), so fetch it on the first run instead.
if [ ! -x "$NATIVE" ] && command -v node >/dev/null 2>&1; then
  echo "kttn: downloading the kttn binary for this computer (first run)..." >&2
  node "$DIR/install.js" >&2 || true
fi
if [ -x "$NATIVE" ]; then
  exec "$NATIVE" "$@"
fi
echo "kttn binary was not installed." >&2
echo "Reinstall with: npm install -g @hgwk/kttn@latest" >&2
exit 1
